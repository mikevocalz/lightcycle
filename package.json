{
  "name": "lightcycle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:glb": "npm run textures && blender --factory-startup --background --python-exit-code 1 --python tools/build_lightcycle.py",
    "validate": "python3 tools/validate_glb.py assets/export/lightcycle.glb --manifest assets/export/manifest.json",
    "render:lightsoff": "blender --factory-startup -b assets/source/lightcycle_blockout.blend --python-exit-code 1 -P tools/render_matrix.py -- --lights-off",
    "pack": "python3 tools/pack_runtime.py",
    "rider": "blender --factory-startup -b assets/source/lightcycle_blockout.blend --python-exit-code 1 -P tools/rider_proxy.py",
    "test": "node src/three/adapter.test.ts && node src/viro/adapter.test.ts && node src/runtime/runtime.test.ts",
    "check": "npm run build:glb && npm run validate && npm run pack && npm run typecheck && npm test",
    "textures": "python3 tools/generate_textures.py",
    "lods": "python3 tools/build_lods.py",
    "profile": "python3 tools/profile_asset.py",
    "qa:matrix": "blender --factory-startup -b assets/source/lightcycle_blockout.blend --python-exit-code 1 -P tools/render_matrix.py -- --matrix --engine BLENDER_EEVEE --samples 8 --res 720",
    "qa:ci": "blender --factory-startup -b assets/source/lightcycle_blockout.blend --python-exit-code 1 -P tools/render_matrix.py -- --matrix --matrix-colors blue,gold,white --matrix-views side,front34,rear,reactor,wheel --engine BLENDER_EEVEE --samples 4 --res 480",
    "preview": "python3 -m http.server 4173",
    "check:ci": "npm run build:glb && npm run validate && npm run typecheck && npm test && npm run rider && npm run lods && npm run profile",
    "qa:clay": "blender --factory-startup -b assets/source/lightcycle_blockout.blend --python-exit-code 1 -P tools/render_matrix.py -- --clay-suite --engine CYCLES --samples 8 --res 720 --output-dir assets/render/clay",
    "qa:comparison": "python3 tools/compose_comparison.py --renders assets/render/reference-review --reference docs/references/00_generated_hybrid_concept.png.png --out assets/render/reference-comparison.png",
    "validate:textures": "python3 tools/check_texture_contract.py assets/export/lightcycle.glb",
    "validate:body": "blender --factory-startup -b assets/source/lightcycle_blockout.blend --python-exit-code 1 -P tools/check_body_rider.py",
    "validate:canopy": "blender --factory-startup -b assets/source/lightcycle_blockout.blend --python-exit-code 1 -P tools/check_canopy_sweep.py -- --out assets/evidence/canopy-sweep.json",
    "validate:wheels": "python3 tools/check_preserved_wheels.py assets/export/lightcycle.glb --report assets/evidence/wheel-preservation.json"
  },
  "dependencies": {
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0"
  }
}
